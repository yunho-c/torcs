[configuration]

entry_symbol = "torcs_bridge_library_init"
compatibility_minimum = "4.6"
reloadable = true

[libraries]

macos.debug = "res://bin/libtorcs_gdextension.dylib"
macos.release = "res://bin/libtorcs_gdextension.dylib"
linux.debug.x86_64 = "res://bin/libtorcs_gdextension.so"
linux.release.x86_64 = "res://bin/libtorcs_gdextension.so"
windows.debug.x86_64 = "res://bin/torcs_gdextension.dll"
windows.release.x86_64 = "res://bin/torcs_gdextension.dll"
